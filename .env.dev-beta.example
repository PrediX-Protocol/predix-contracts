# ============================================================================
# PrediX V2 — DEV BETA mainnet deployment environment
# ============================================================================
# Lightweight deployment for internal developer testing on Unichain mainnet
# (chainId 130). The smart contracts are the same as production — only the
# operational posture is relaxed:
#
#   - One Safe (2-of-3 or 3-of-5) holds every admin role except PAUSER.
#   - PAUSER stays separate as a KMS-backed hot wallet so emergency pause
#     does not require the governance quorum.
#   - No formal key ceremony, no 24/7 on-call rotation, no public bug
#     bounty.
#   - Caps stay deliberately small ($5k per market) so developer mistakes
#     are bounded.
#
# Use this profile for:
#   - Real Chainlink integration tests against canonical mainnet feeds
#   - End-to-end smoke against real Permit2 / Uniswap v4 PoolManager / USDC
#   - Internal team + select tester onboarding
#
# Do NOT use this profile for:
#   - Public marketing or open user acquisition (graduate to .env.beta first)
#   - Production launch (graduate to a full 4-Safe deploy per
#     SAFE_DEPLOYMENT_RUNBOOK.md)
#
# Graduation: rotate addresses via the existing role-grant flow on the
# diamond, deploy new Safes, then run PostDeployVerify against the new
# layout. No code change required.
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---------- RPC endpoints ----------
UNICHAIN_RPC_PRIMARY=
UNICHAIN_RPC_BACKUP=

# ---------- Fork test harness ----------
UNICHAIN_MAINNET_PIN_BLOCK=48436395

# ---------- Deployer ----------
# Dev beta may use a hardware wallet via `--ledger` OR a KMS-backed EOA. The
# deployer key holds admin only for the duration of the broadcast and is
# renounced in-broadcast when DIAMOND_FINALIZE_GOVERNANCE=true (below).
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# ---------- Single team Safe holds every admin role except PAUSER ----------
# Acceptable for dev beta: the blast radius of a Safe compromise is bounded
# by the conservative caps below. Production must split into four Safes per
# KEY_MANAGEMENT_POLICY.md v2.0 — see DEV_BETA_SETUP.md "Graduation".
TEAM_SAFE=

MULTISIG_ADDRESS=${TEAM_SAFE}
HOOK_PROXY_ADMIN=${TEAM_SAFE}
EXCHANGE_PROXY_ADMIN=${TEAM_SAFE}
HOOK_RUNTIME_ADMIN=${TEAM_SAFE}
PAYMASTER_OWNER=${TEAM_SAFE}
OPERATOR_ADDRESS=${TEAM_SAFE}
REPORTER_ADDRESS=${TEAM_SAFE}

# ---------- Pauser stays separate so emergency response is fast ----------
# KMS-backed hot wallet (AWS KMS, GCP KMS, HashiCorp Vault). The pauser key
# is reachable by an on-call engineer during business hours; emergency
# response targets < 60 minutes during the dev-beta window.
PAUSER_ADDRESS=

# Fee sink — separate hot wallet OR team Safe, operator's choice
FEE_RECIPIENT=

# ---------- Timelock ----------
# Floor stays at 48h even for dev beta — gives the team time to revert any
# accidental cut proposal.
TIMELOCK_DELAY_SECONDS=172800

# ---------- Chain-specific canonical addresses (Unichain mainnet) ----------
USDC_ADDRESS=0x078D782b760474a361dDA0AF3839290b0EF57AD6
POOL_MANAGER_ADDRESS=0x1F98400000000000000000000000000000000004
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
V4_QUOTER_ADDRESS=0x333E3C607B141b18fF6de9f258db6e77fE7491E0

# ---------- Chainlink ----------
# Dev beta default: ManualOracle only. Flip to `true` and supply
# REGISTRAR_ADDRESS + CHAINLINK_SEQUENCER_UPTIME_FEED to enable real
# Chainlink integration testing once a published feed is available on the
# target chain.
CHAINLINK_ENABLED=false
# REGISTRAR_ADDRESS=${TEAM_SAFE}
# CHAINLINK_SEQUENCER_UPTIME_FEED=

# ---------- Protocol parameters (DEV BETA — deliberately small) ----------
MARKET_CREATION_FEE=10000000            # 10 USDC anti-spam
DEFAULT_PER_MARKET_CAP=5000000000       # 5k USDC per market (10x lower than public beta)
DEFAULT_REDEMPTION_FEE_BPS=100          # 1.00%

# ---------- v4 pool config (router immutables) ----------
LP_FEE_FLAG=8388608                     # 0x800000 = dynamic fee flag
TICK_SPACING=60

# ---------- Governance finalisation ----------
# Required for dev beta: the deployer EOA must not retain any admin role
# after the broadcast lands.
DIAMOND_FINALIZE_GOVERNANCE=true

# ---------- Populated after DeployAll (used by PostDeployVerify) ----------
DIAMOND_ADDRESS=
EXCHANGE_ADDRESS=
HOOK_PROXY_ADDRESS=
ROUTER_ADDRESS=
ORACLE_MANUAL_ADDRESS=
TIMELOCK_ADDRESS=
