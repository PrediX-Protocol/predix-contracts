# ============================================================================
# PrediX V2 — BETA MAINNET deployment environment
# ============================================================================
# Conservative defaults for the beta launch on Unichain mainnet (chainId 130).
# Differs from `.env.example` only in:
#   1. Caps deliberately low (50k USDC per market, 10 USDC creation fee)
#   2. Redemption fee enabled at 1.00%
#   3. CHAINLINK_ENABLED=false (Unichain has no published Chainlink sequencer
#      uptime feed at the time of writing — beta uses ManualOracle only;
#      ChainlinkOracle can be approved post-launch once Chainlink publishes
#      Unichain feeds)
#   4. Notes on Safe binding per KEY_MANAGEMENT_POLICY.md v2.0
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---------- RPC endpoints ----------
UNICHAIN_RPC_PRIMARY=
UNICHAIN_RPC_BACKUP=

# ---------- Fork test harness ----------
UNICHAIN_MAINNET_PIN_BLOCK=48436395

# ---------- Deployer ----------
# Production beta MUST use a hardware wallet via `--ledger`; never inline the
# private key in a real-deploy `.env`.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# ---------- Safe bindings (one Safe per role per KEY_MANAGEMENT_POLICY.md) ----
# Safe 1 — Protocol Governance (3-of-5 hardware)
MULTISIG_ADDRESS=
OPERATOR_ADDRESS=
REPORTER_ADDRESS=

# Safe 2 — Upgrade Governance (3-of-5 hardware, no signer overlap with Safe 1)
HOOK_PROXY_ADMIN=
EXCHANGE_PROXY_ADMIN=

# Safe 3 — Operations (2-of-4 hardware/KMS)
HOOK_RUNTIME_ADMIN=
PAYMASTER_OWNER=

# Safe 4 — Incident Response (2-of-3 hardware, on-call)
PAUSER_ADDRESS=

# Fee sink — distinct hot wallet OR Safe 1, operator's choice
FEE_RECIPIENT=

# ---------- Timelock ----------
TIMELOCK_DELAY_SECONDS=172800           # 48h floor; raise to 5-7d after 1 week of clean beta

# ---------- Chain-specific canonical addresses (Unichain mainnet) ----------
USDC_ADDRESS=0x078D782b760474a361dDA0AF3839290b0EF57AD6
POOL_MANAGER_ADDRESS=0x1F98400000000000000000000000000000000004
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
V4_QUOTER_ADDRESS=0x333E3C607B141b18fF6de9f258db6e77fE7491E0

# ---------- Chainlink ----------
# Beta posture: disabled. ManualOracle covers the beta market set; flip to
# `true` and supply REGISTRAR_ADDRESS + CHAINLINK_SEQUENCER_UPTIME_FEED only
# after Chainlink publishes a Unichain sequencer feed.
CHAINLINK_ENABLED=false
# REGISTRAR_ADDRESS=
# CHAINLINK_SEQUENCER_UPTIME_FEED=

# ---------- Protocol parameters (BETA conservative) ----------
MARKET_CREATION_FEE=10000000            # 10 USDC anti-spam
DEFAULT_PER_MARKET_CAP=50000000000      # 50k USDC per market
DEFAULT_REDEMPTION_FEE_BPS=100          # 1.00%

# ---------- v4 pool config (router immutables) ----------
LP_FEE_FLAG=8388608                     # 0x800000 = dynamic fee flag
TICK_SPACING=60

# ---------- Governance finalisation ----------
# Beta MUST finalise in-broadcast so the deployer EOA does not retain admin.
DIAMOND_FINALIZE_GOVERNANCE=true

# ---------- Populated after DeployAll (used by PostDeployVerify) ----------
DIAMOND_ADDRESS=
EXCHANGE_ADDRESS=
HOOK_PROXY_ADDRESS=
ROUTER_ADDRESS=
ORACLE_MANUAL_ADDRESS=
TIMELOCK_ADDRESS=
